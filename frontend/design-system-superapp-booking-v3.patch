+.dashboard-booking-date span { font-size: 10px; font-weight: 700; text-transform: uppercase; }
+.dashboard-booking-info { flex: 1; min-width: 0; }
+.dashboard-booking-info h3 { overflow: hidden; margin: 0 0 4px; color: #243d2d; font-size: 13px; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
+.dashboard-booking-info p { overflow: hidden; margin: 0; color: #839087; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
+.dashboard-booking-status { display: inline-flex; align-items: center; gap: 5px; padding: 6px 9px; border-radius: 20px; font-size: 10px; font-weight: 800; white-space: nowrap; }
+.dashboard-list-state { padding: 28px 0; color: #839087; font-size: 12px; text-align: center; }
+.dashboard-empty { display: flex; flex-direction: column; align-items: center; padding: 28px 12px 18px; border-top: 1px solid #edf1ed; text-align: center; }
+.dashboard-empty a { display: inline-flex; align-items: center; gap: 6px; color: var(--sc-primary); font-size: 12px; font-weight: 800; text-decoration: none; }
+.dashboard-error { padding: 12px 15px; border: 1px solid #f2ceca; border-radius: 8px; background: #fff3f1; color: #b3261e; font-size: 12px; }
+.dashboard-help-strip { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 23px 25px; border: 1px solid #dce9df; border-radius: 12px; background: #edf5ef; }
+.dashboard-help-strip .eyebrow { color: var(--sc-primary); }
+.dashboard-help-strip h2 { margin: 5px 0 4px; color: #183c29; font-size: 17px; font-weight: 800; letter-spacing: -.03em; }
+.dashboard-help-strip p { margin: 0; color: #718077; font-size: 11px; }
+.dashboard-help-strip > a { display: inline-flex; align-items: center; gap: 7px; flex-shrink: 0; padding: 10px 13px; border-radius: 7px; background: var(--sc-primary); color: #fff; font-size: 11px; font-weight: 800; text-decoration: none; }
+.dashboard-help-strip > a:hover { background: var(--sc-primary-dark); }
+
+@media (max-width: 900px) {
+  .room-card-grid { grid-template-columns: 1fr; }
+  .room-card-image { height: 205px; }
+  .dashboard-welcome-art { margin-right: 0; transform: scale(.88); transform-origin: right center; }
+}
+@media (max-width: 640px) {
+  .booking-discovery, .user-dashboard { gap: 20px; }
+  .booking-page-intro { min-height: 210px; padding: 25px 22px; }
+  .booking-page-intro h1 { max-width: 440px; font-size: 31px; }
+  .booking-intro-mark { display: none; }
+  .booking-search-panel { align-items: stretch; flex-direction: column; gap: 10px; padding: 12px; }
+  .booking-filter-control { justify-content: space-between; padding: 10px 0 0; border-top: 1px solid var(--sc-border); border-left: 0; }
+  .booking-date-row { align-items: flex-start; flex-direction: column; }
+  .booking-date-row > div:last-child { width: 100%; justify-content: flex-start; }
+  .booking-results-heading { align-items: flex-start; flex-direction: column; gap: 8px; }
+  .room-legend { gap: 10px; }
+  .room-legend-note { width: 100%; margin-left: 0; }
+  .room-card-image { height: 180px; }
+  .room-card-body { padding: 15px 13px 12px; }
+  .room-card-heading h2 { font-size: 15px; }
+  .room-slots { gap: 4px; }
+  .room-slot { height: 34px; font-size: 10px; }
+  .dashboard-welcome { min-height: 230px; padding: 26px 22px; }
+  .dashboard-welcome-art { display: none; }
+  .dashboard-welcome h1 { font-size: 34px; }
+  .dashboard-stat-grid { grid-template-columns: 1fr; gap: 9px; }
+  .dashboard-stat-card { min-height: 100px; padding: 15px 17px; }
+  .dashboard-stat-card strong { font-size: 26px; }
+  .dashboard-bookings-section { padding: 15px 13px; }
+  .dashboard-booking-row { gap: 9px; }
+  .dashboard-booking-info h3 { font-size: 12px; }
+  .dashboard-booking-info p { font-size: 10px; }
+  .dashboard-booking-status { padding: 5px 7px; font-size: 9px; }
+  .dashboard-help-strip { align-items: flex-start; flex-direction: column; padding: 19px; }
+  .dashboard-help-strip > a { width: 100%; justify-content: center; }
+}
