@@ -0,0 +1,66 @@
+import { useEffect, useRef, useState } from 'react';
+import { useNavigate, useSearchParams } from 'react-router-dom';
+import { API_BASE_URL } from '../../config/api.js';
+import { useAuth } from '../../contexts/AuthContext.jsx';
+
+const SsoCallback = () => {
+  const [searchParams] = useSearchParams();
+  const navigate = useNavigate();
+  const { login } = useAuth();
+  const started = useRef(false);
+  const [message, setMessage] = useState('Memverifikasi sesi My-SUKA...');
+
+  useEffect(() => {
+    if (started.current) return;
+    started.current = true;
+
+    const token = searchParams.get('token');
+    // Remove the handoff token from the visible URL/history immediately.
+    window.history.replaceState({}, document.title, window.location.pathname);
+
+    if (!token) {
+      setMessage('Token SSO tidak ditemukan. Silakan masuk melalui My-SUKA.');
+      return;
+    }
+
+    const exchange = async () => {
+      try {
+        const response = await fetch(`${API_BASE_URL}/auth/sso`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ token }),
+        });
+        const data = await response.json().catch(() => ({}));
+        if (!response.ok) throw new Error(data.message || 'Autentikasi SSO gagal.');
+        if (!data.token || !data._id || !data.role) {
+          throw new Error('Respons autentikasi SSO tidak lengkap.');
+        }
+        login(data, data.token);
+        navigate(data.role === 'admin' ? '/admin/dashboard' : '/dashboard', { replace: true });
+      } catch (error) {
+        setMessage(error.message || 'Tidak dapat menghubungi server TERAS-SC.');
+      }
+    };
+
+    exchange();
+  }, [login, navigate, searchParams]);
+
+  return (
+    <main className="min-h-screen flex items-center justify-center bg-[#F8FAFC] px-4">
+      <section className="w-full max-w-md rounded-2xl bg-white p-8 text-center shadow-xl">
+        <h1 className="text-2xl font-bold text-[#155E38]">TERAS SC</h1>
+        <p className="mt-3 text-sm text-gray-600" role="status">{message}</p>
+        {message !== 'Memverifikasi sesi My-SUKA...' && (
+          <a
+            href="https://zamsiska.my.id"
+            className="mt-5 inline-flex rounded-lg bg-[#155E38] px-4 py-2 text-sm font-semibold text-white"
+          >
+            Kembali ke My-SUKA
+          </a>
+        )}
+      </section>
+    </main>
+  );
+};
+
+export default SsoCallback;
